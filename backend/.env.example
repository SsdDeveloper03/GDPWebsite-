# ==============================================================================
# Production Environment Configuration Template
# Copy this file to .env and fill in real production credentials
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5000

# Client Domain (Used for CORS and Cookie origin in production)
# Example: https://growthkadigitalpartner.com or https://yourdomain.com
CLIENT_URL=https://yourdomain.com

# 32+ character random secret for signing session cookies
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_secure_random_32_character_hex_string

# SQL Server Database Connection String
# Format: sqlserver://<HOST>:<PORT>;database=<DB_NAME>;user=<USER>;password=<PASSWORD>;encrypt=true;trustServerCertificate=false;
DATABASE_URL="sqlserver://localhost:1433;database=GDPWebsiteDB_Prod;user=gdp_app_user;password=StrongPassword123!;encrypt=true;trustServerCertificate=true;"

# WhatsApp Notification Integration (Getgabs API)
GETGABS_API_URL=https://app.getgabs.com/whatsappbusiness/send-templated-message
GETGABS_API_KEY=your_production_getgabs_api_key_here
GETGABS_SENDER=918799441838
GETGABS_CAMPAIGN_ID=26103
GETGABS_TEAM_PHONE=919727001838
