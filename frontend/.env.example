# ==============================================================================
# Frontend Environment Configuration Template
# ==============================================================================

# In production with Nginx reverse proxy on the same domain, leave this EMPTY
# so all requests go to /api natively without cross-origin cookie issues:
VITE_API_URL=

# If using decoupled hosting (e.g., Frontend on Vercel/Netlify, Backend on VPS/Render):
# VITE_API_URL=https://api.yourdomain.com
